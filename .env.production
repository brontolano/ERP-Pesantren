# Asy-Syifaa Production Deployment — Environment Variables

# ===== APP CORE =====
APP_ENV=production
APP_DEBUG=false
APP_URL=https://erp.asy-syifaa.com

# ===== DATABASE =====
DB_CONNECTION=pgsql
DB_HOST=postgresql
DB_PORT=5432
DB_DATABASE=erp_pesantren
DB_USERNAME=pesantren
DB_PASSWORD=ASy-5Yifaa

# ===== REDIS =====
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# ===== JWT / API =====
JWT_SECRET=your-super-secret-jwt-key-change-me
API_KEY_ERP=your-api-key-erp
API_KEY_DATAMASTER=your-api-key-datamaster

# ===== TRAEFIK / SSL =====
LETSENCRYPT_EMAIL=admin@asy-syifaa.com

# ===== MAIL (if needed) =====
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=your-mailtrap-user
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM_ADDRESS=noreply@asy-syifaa.com
MAIL_FROM_NAME="Asy-Syifaa Pesantren"

# ===== EXTERNAL APIs =====
# WhatsApp Gateway
WAHA_URL=http://waha:3000
WAHA_TOKEN=your-waha-token

# n8n Workflow
N8N_URL=http://n8n:5678
N8N_API_KEY=your-n8n-api-key

# AWS S3 (if using S3 for media)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=asy-syifaa-media

# ===== DEBUG / MONITORING =====
LOG_CHANNEL=daily
LOG_LEVEL=info
SENTRY_LARAVEL_DSN=
