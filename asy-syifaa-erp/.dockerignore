# Root .dockerignore — shared across all services

# Git
.git
.gitignore
.gitmodules
.github

# Dependencies (handled by Docker layers)
node_modules
vendor
*.lock

# Development
.env.example
.vscode
.idea
*.log
npm-debug.log*
yarn-debug.log*

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# Build artifacts (will be rebuilt in Docker)
dist
build
.next
.nuxt
coverage
.nyc_output

# Temporary
tmp
temp
*.tmp

# VCS
*.orig
.merge-files

# Docs
docs
CHANGELOG.md
PROGRESS.md
*.md

# Backups & Archives
backups
*.bak
*.backup
archives
